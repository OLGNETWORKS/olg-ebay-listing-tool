{
  "name": "olg-ebay-listing-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:framework": "next build tests/compiler/framework-smoke",
    "start": "next start",
    "test": "npm run test:compiler && npm run test:orchestration",
    "test:compiler": "vitest run tests/compiler",
    "test:orchestration": "node --test tests/orchestration/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.12.0",
    "@prisma/client": "6.12.0",
    "next": "16.3.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "prisma": "6.12.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
